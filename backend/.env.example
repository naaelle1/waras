PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Turso Cloud Database (libSQL)
# Dapatkan melalui Turso CLI:
# 1. turso auth login
# 2. turso db create waras-db
# 3. turso db show --url waras-db (isi ke TURSO_DATABASE_URL)
# 4. turso db tokens create waras-db (isi ke TURSO_AUTH_TOKEN)
#
# Jika dikosongkan, backend otomatis beralih ke local libSQL/SQLite (file:backend/data/waras.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT Secret untuk otorisasi Bearer token
JWT_SECRET=waras-semarang-secret-key-2026

